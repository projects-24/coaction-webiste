# Copy to .env.local (development) or set these in your hosting provider.
# Never commit real values.

# --- Live domain -------------------------------------------------------------
# Set ONLY once the official domain is confirmed, e.g. https://www.example.com
# While unset: robots.txt disallows everything, pages carry noindex, and no
# canonical URLs or sitemap entries are published.
SITE_URL=

# --- Enquiry form delivery ---------------------------------------------------
# Choose one: smtp | webhook. While unset the form tells visitors the message
# was NOT sent and shows the phone and email alternatives.
ENQUIRY_DELIVERY=

# smtp: sends each enquiry as an email through your mail provider.
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS); leave unset for 587 (STARTTLS).
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
# Inbox that receives enquiries, e.g. Training@coaction.com
ENQUIRY_TO_EMAIL=
# Sender address your SMTP account is allowed to send from.
ENQUIRY_FROM_EMAIL=

# webhook: POSTs each enquiry as JSON to a system you control (CRM, automation
# tool, helpdesk). Must answer 2xx to count as accepted.
ENQUIRY_WEBHOOK_URL=
# Optional. Sent as "Authorization: Bearer <secret>".
ENQUIRY_WEBHOOK_SECRET=
